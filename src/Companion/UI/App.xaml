<Application x:Class="PWCompanion.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ButlerBackground" Color="#1a1a2e"/>
            <SolidColorBrush x:Key="ButlerAccent" Color="#e94560"/>
            <SolidColorBrush x:Key="ButlerText" Color="#eaeaea"/>
            <SolidColorBrush x:Key="ButlerMuted" Color="#888888"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
